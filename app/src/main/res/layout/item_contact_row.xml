<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_12"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_rounded"
    android:padding="@dimen/spacing_16"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/text_contact_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/chub_text_primary"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                tools:text="Ramesh Electrician" />

            <ImageView
                android:id="@+id/image_contact_favorite"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="@dimen/spacing_4"
                android:contentDescription="@null"
                android:src="@drawable/ic_favorite" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_contact_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/chub_text_secondary"
            android:textSize="@dimen/text_size_small"
            tools:text="Electrician • 98765 43210" />
    </LinearLayout>

    <ImageView
        android:id="@+id/image_action_call"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:background="@drawable/bg_quick_action"
        android:contentDescription="@null"
        android:src="@drawable/ic_call" />

    <ImageView
        android:id="@+id/image_action_whatsapp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="@dimen/spacing_8"
        android:padding="8dp"
        android:background="@drawable/bg_quick_action"
        android:contentDescription="@null"
        android:src="@drawable/ic_whatsapp" />

</LinearLayout>
