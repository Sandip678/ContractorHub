<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_12"
    android:orientation="vertical"
    android:background="@drawable/bg_card_rounded"
    android:padding="@dimen/spacing_16"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/text_row_site_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/chub_text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            tools:text="Patil Residence" />

        <TextView
            android:id="@+id/text_row_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_status"
            android:paddingHorizontal="@dimen/spacing_8"
            android:paddingVertical="2dp"
            android:textColor="@color/chub_success"
            android:textSize="@dimen/text_size_small"
            android:textStyle="bold"
            tools:text="Active" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_row_client_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:textColor="@color/chub_text_secondary"
        android:textSize="@dimen/text_size_small"
        tools:text="Client: Mr. Patil" />

    <TextView
        android:id="@+id/text_row_contract_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:textColor="@color/chub_primary"
        android:textSize="@dimen/text_size_body"
        android:textStyle="bold"
        tools:text="₹10,00,000 Contract" />

</LinearLayout>
