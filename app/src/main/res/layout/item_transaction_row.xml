<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/spacing_12"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/image_transaction_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="@dimen/spacing_12"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_transaction_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/chub_text_primary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            tools:text="Client A Payment"
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView
            android:id="@+id/text_transaction_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/chub_text_secondary"
            android:textSize="@dimen/text_size_small"
            tools:text="Patil Residence"
            xmlns:tools="http://schemas.android.com/tools" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_transaction_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_body"
        android:textStyle="bold"
        tools:text="+₹50,000"
        xmlns:tools="http://schemas.android.com/tools" />

</LinearLayout>
