<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_12"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_rounded"
    android:padding="@dimen/spacing_16"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_row_material_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/chub_text_primary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            tools:text="Cement" />

        <TextView
            android:id="@+id/text_row_material_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/chub_text_secondary"
            android:textSize="@dimen/text_size_small"
            tools:text="Cement • ₹380/bag" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/text_row_material_stock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/chub_text_primary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            tools:text="18 bag" />

        <TextView
            android:id="@+id/text_row_low_stock_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_chip_warning"
            android:paddingHorizontal="@dimen/spacing_8"
            android:paddingVertical="1dp"
            android:text="@string/material_low_stock_badge"
            android:textColor="@color/chub_warning"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
