<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chub_background"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/spacing_24">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/text_material_profile_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/chub_text_primary"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold"
                tools:text="Cement" />

            <ImageView
                android:id="@+id/image_edit_material"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:background="@drawable/bg_quick_action"
                android:contentDescription="@null"
                android:src="@drawable/ic_edit" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_material_profile_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/chub_text_secondary"
            android:textSize="@dimen/text_size_body"
            tools:text="Cement • ₹380/bag" />

        <!-- Stock card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="@dimen/spacing_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/material_current_stock"
                android:textColor="@color/chub_text_secondary"
                android:textSize="@dimen/text_size_small" />

            <TextView
                android:id="@+id/text_current_stock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/chub_primary"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold"
                tools:text="18 bag" />

            <TextView
                android:id="@+id/text_low_stock_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="@string/material_low_stock_badge"
                android:textColor="@color/chub_warning"
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/text_minimum_stock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:textColor="@color/chub_text_secondary"
                android:textSize="@dimen/text_size_small"
                tools:text="Minimum stock: 30 bag" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_add_stock_transaction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:backgroundTint="@color/chub_primary"
            android:text="@string/material_add_stock_transaction" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:text="@string/material_stock_history"
            android:textColor="@color/chub_text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_stock_history_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="@string/material_stock_history_empty"
            android:textColor="@color/chub_text_secondary"
            android:textSize="@dimen/text_size_small" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:paddingHorizontal="@dimen/spacing_16">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_stock_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_stock_transaction_row" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
