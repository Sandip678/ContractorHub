<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_12"
    android:orientation="vertical"
    android:background="@drawable/bg_card_rounded"
    android:padding="@dimen/spacing_16">

    <TextView
        android:id="@+id/text_diary_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/chub_text_primary"
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold"
        tools:text="22 August 2026" />

    <LinearLayout
        android:id="@+id/layout_diary_entries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:orientation="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="@dimen/spacing_8"
        android:background="@color/chub_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diary_income_label"
                android:textColor="@color/chub_text_secondary"
                android:textSize="@dimen/text_size_small" />

            <TextView
                android:id="@+id/text_diary_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/chub_success"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                tools:text="₹50,000" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diary_expense_label"
                android:textColor="@color/chub_text_secondary"
                android:textSize="@dimen/text_size_small" />

            <TextView
                android:id="@+id/text_diary_expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/chub_error"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                tools:text="₹22,500" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diary_net_label"
                android:textColor="@color/chub_text_secondary"
                android:textSize="@dimen/text_size_small" />

            <TextView
                android:id="@+id/text_diary_net"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/chub_text_primary"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                tools:text="₹27,500" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
