<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chub_background"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/spacing_24">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <!-- Header -->
        <TextView
            android:id="@+id/text_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/chub_text_secondary"
            android:textSize="@dimen/text_size_body"
            tools:text="Good Morning" />

        <TextView
            android:id="@+id/text_owner_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/chub_text_primary"
            android:textSize="@dimen/text_size_headline"
            android:textStyle="bold"
            tools:text="Sandip" />

        <!-- Active Sites + Income/Expense card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="@dimen/spacing_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_active_sites"
                android:textColor="@color/chub_text_secondary"
                android:textSize="@dimen/text_size_small" />

            <TextView
                android:id="@+id/text_active_sites_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/chub_primary"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold"
                tools:text="05" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_12"
                android:background="@color/chub_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_today_income"
                        android:textColor="@color/chub_text_secondary"
                        android:textSize="@dimen/text_size_small" />

                    <TextView
                        android:id="@+id/text_today_income"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/chub_success"
                        android:textSize="@dimen/text_size_amount"
                        android:textStyle="bold"
                        tools:text="₹25,000" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_today_expense"
                        android:textColor="@color/chub_text_secondary"
                        android:textSize="@dimen/text_size_small" />

                    <TextView
                        android:id="@+id/text_today_expense"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/chub_error"
                        android:textSize="@dimen/text_size_amount"
                        android:textStyle="bold"
                        tools:text="₹8,500" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Pending + Labour payable row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_8"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:padding="@dimen/spacing_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_pending_receivable"
                    android:textColor="@color/chub_text_secondary"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/text_pending_receivable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:textColor="@color/chub_text_primary"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold"
                    tools:text="₹2,40,000" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_8"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:padding="@dimen/spacing_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_labour_payable"
                    android:textColor="@color/chub_text_secondary"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/text_labour_payable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:textColor="@color/chub_text_primary"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold"
                    tools:text="₹35,500" />
            </LinearLayout>
        </LinearLayout>

        <!-- Low stock warning -->
        <LinearLayout
            android:id="@+id/layout_low_stock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip_warning"
            android:padding="@dimen/spacing_12">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="@dimen/spacing_8"
                android:contentDescription="@null"
                android:src="@drawable/ic_warning" />

            <TextView
                android:id="@+id/text_low_stock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/chub_warning"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                tools:text="7 items low on stock" />
        </LinearLayout>

        <!-- Insights (PART 71) -->
        <LinearLayout
            android:id="@+id/layout_insights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="@dimen/spacing_16" />

        <!-- Quick actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:text="@string/dashboard_quick_actions"
            android:textColor="@color/chub_text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_quick_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:clipToPadding="false"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_quick_action" />

        <!-- Site status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:text="@string/dashboard_site_status"
            android:textColor="@color/chub_text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_site_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:clipToPadding="false"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_site_status" />

        <!-- Recent transactions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:text="@string/dashboard_recent_transactions"
            android:textColor="@color/chub_text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:paddingHorizontal="@dimen/spacing_16">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_transactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_transaction_row" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
