<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_12"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_rounded"
    android:padding="@dimen/spacing_16"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_row_payment_client"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/chub_text_primary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            tools:text="Mr. Patil" />

        <TextView
            android:id="@+id/text_row_payment_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/chub_text_secondary"
            android:textSize="@dimen/text_size_small"
            tools:text="Patil Residence • UPI • 22 Aug 2026" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_row_payment_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/chub_success"
        android:textSize="@dimen/text_size_body"
        android:textStyle="bold"
        tools:text="+₹50,000" />

</LinearLayout>
