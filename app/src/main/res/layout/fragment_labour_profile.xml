<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chub_background"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/spacing_24">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/text_profile_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/chub_text_primary"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold"
                tools:text="Ramesh Shinde" />

            <ImageView
                android:id="@+id/image_edit_labour"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:background="@drawable/bg_quick_action"
                android:contentDescription="@null"
                android:src="@drawable/ic_edit" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_profile_worktype"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/chub_text_secondary"
            android:textSize="@dimen/text_size_body"
            tools:text="Mason • ₹800/day" />

        <!-- Balance card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="@dimen/spacing_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/labour_current_balance"
                android:textColor="@color/chub_text_secondary"
                android:textSize="@dimen/text_size_small" />

            <TextView
                android:id="@+id/text_balance_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/chub_error"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold"
                tools:text="₹23,500 Payable" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_12"
                android:background="@color/chub_border" />

            <TextView
                android:id="@+id/text_work_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/chub_text_secondary"
                android:textSize="@dimen/text_size_small"
                tools:text="24 Days • 2 Half Days • 3 OT Hours" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_12"
                android:background="@color/chub_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/labour_total_earned"
                        android:textColor="@color/chub_text_secondary"
                        android:textSize="@dimen/text_size_small" />

                    <TextView
                        android:id="@+id/text_total_earned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/chub_success"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        tools:text="₹32,000" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/labour_paid"
                        android:textColor="@color/chub_text_secondary"
                        android:textSize="@dimen/text_size_small" />

                    <TextView
                        android:id="@+id/text_paid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/chub_text_primary"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        tools:text="₹8,500" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/labour_advance"
                        android:textColor="@color/chub_text_secondary"
                        android:textSize="@dimen/text_size_small" />

                    <TextView
                        android:id="@+id/text_advance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/chub_text_primary"
                        android:textSize="@dimen/text_size_body"
                        tools:text="₹5,000" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/labour_angavar"
                        android:textColor="@color/chub_text_secondary"
                        android:textSize="@dimen/text_size_small" />

                    <TextView
                        android:id="@+id/text_angavar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/chub_text_primary"
                        android:textSize="@dimen/text_size_body"
                        tools:text="₹3,500" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_add_attendance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_8"
                android:backgroundTint="@color/chub_primary"
                android:text="@string/labour_add_attendance" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_add_transaction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_8"
                android:backgroundTint="@color/chub_secondary"
                android:text="@string/labour_add_transaction" />

        </LinearLayout>

        <!-- Attendance history -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:text="@string/labour_attendance_history"
            android:textColor="@color/chub_text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_attendance_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="@string/labour_attendance_empty"
            android:textColor="@color/chub_text_secondary"
            android:textSize="@dimen/text_size_small" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:paddingHorizontal="@dimen/spacing_16">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_attendance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_attendance_row" />
        </LinearLayout>

        <!-- Transaction ledger -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:text="@string/labour_ledger_history"
            android:textColor="@color/chub_text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_ledger_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="@string/labour_ledger_empty"
            android:textColor="@color/chub_text_secondary"
            android:textSize="@dimen/text_size_small" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:paddingHorizontal="@dimen/spacing_16">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_ledger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_ledger_row" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
