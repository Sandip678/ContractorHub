<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/spacing_8">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_ledger_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/chub_text_primary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            tools:text="Advance" />

        <TextView
            android:id="@+id/text_ledger_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/chub_text_secondary"
            android:textSize="@dimen/text_size_small"
            tools:text="22 Aug 2026" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_ledger_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_8"
        android:textColor="@color/chub_error"
        android:textSize="@dimen/text_size_body"
        android:textStyle="bold"
        tools:text="-₹5,000" />

    <ImageView
        android:id="@+id/image_delete_ledger"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="6dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_delete_small" />

</LinearLayout>
