<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_12"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_rounded"
    android:padding="@dimen/spacing_16"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_row_bill_supplier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/chub_text_primary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            tools:text="ABC Cement Suppliers" />

        <TextView
            android:id="@+id/text_row_bill_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/chub_text_secondary"
            android:textSize="@dimen/text_size_small"
            tools:text="#INV-104 • 22 Aug 2026" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/text_row_bill_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/chub_text_primary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            tools:text="₹12,500" />

        <TextView
            android:id="@+id/text_row_bill_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_badge_status"
            android:paddingHorizontal="@dimen/spacing_8"
            android:paddingVertical="1dp"
            android:textColor="@color/chub_success"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="PAID" />
    </LinearLayout>

</LinearLayout>
