<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/spacing_4">

    <ImageView
        android:id="@+id/image_entry_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="@dimen/spacing_8"
        android:contentDescription="@null"
        tools:src="@drawable/ic_trending_down" />

    <TextView
        android:id="@+id/text_entry_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/chub_text_primary"
        android:textSize="@dimen/text_size_small"
        tools:text="Cement — Material" />

    <TextView
        android:id="@+id/text_entry_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_small"
        android:textStyle="bold"
        tools:text="-₹12,000" />

    <ImageView
        android:id="@+id/image_entry_delete"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:padding="6dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_delete_small"
        android:visibility="gone" />

</LinearLayout>
